// Firestore 보안 규칙 (로드맵 4-1 계정, 4-2 학급·세션·학생 기록·연습 기록·관리자 설정, 4-3 채점·면담·설문·연구 도구·진행 제어)
// Firebase 콘솔 > Firestore Database > 규칙에 이 파일 내용을 붙여 넣고 [게시]합니다.
//
// 원칙(AGENTS.md 4절, docs/data-spec.md)
//   - 역할은 승인된 사용자에게만 서버가 붙이는 사용자 지정 클레임 role(admin/teacher/student/guest). 학생이 바꿀 수 없다.
//   - 계정·명단·연결표·설정·학급 구조·세션 코드는 서버 함수(api/, Admin SDK)만 쓴다.
//   - 연결표(links: 이름·학번·이메일)는 관리자와 본인만 읽는다. 교사는 users(연구 번호·역할·세션)만 읽는다.
//   - 학급·세션은 담당 교사(teacherUids)와 관리자만 본다. 학생은 세션 코드로 들어간 세션(members)만 읽는다.
//   - 학생 연구 기록은 본인만 쓰고, 제출한 단계는 바꿀 수 없으며, 교사가 열지 않은 단계에는 쓸 수 없다.
//   - 여기에 적지 않은 문서는 모두 막는다.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.get('role', '') : ''; }
    function isAdmin() { return role() == 'admin'; }
    function isTeacher() { return role() == 'admin' || role() == 'teacher'; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function approved() { return role() != ''; }

    function sessionData(sid) { return get(/databases/$(database)/documents/sessions/$(sid)).data; }
    function teaches(teacherUids) { return isAdmin() || (role() == 'teacher' && request.auth.uid in teacherUids); }
    function teachesSession(sid) { return isAdmin() || (role() == 'teacher' && request.auth.uid in sessionData(sid).teacherUids); }
    function memberOf(sid) { return approved() && exists(/databases/$(database)/documents/sessions/$(sid)/members/$(request.auth.uid)); }

    // ── 계정 (4-1) ──
    match /users/{uid} {
      allow read: if isSelf(uid) || isTeacher();
      // 본인은 "진행 중 세션"만 바꿀 수 있다(사람마다, 4-2)
      allow update: if isSelf(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeSessionId']);
      allow create, delete: if false;
    }
    match /links/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }
    match /roster/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /staff/{uid} {
      allow read: if isTeacher();
      allow write: if false;
    }
    match /settings/{name} {
      allow read: if (signedIn() && (name == 'ethics' || name == 'signup' || name == 'admin' || name == 'tools' || name == 'consent'))
        || (isTeacher() && name == 'ai');  // AI 용도별 모델·한도(5-1): 교사·관리자가 읽고 서버만 쓴다. settings/prompts는 막음(관리자는 api/ai.js로)
      // 연구 도구(루브릭·대화 태그·채점자·AI 보조 채점자·면담 기준·녹음 보관 기한)와 연구 동의서는 관리자가 바로 쓴다(4-3)
      allow write: if isAdmin() && (name == 'tools' || name == 'consent');
    }
    // 설문(문항 세트, 4-3): 모두 읽고 관리자가 쓴다. 학생이 응답을 시작해 잠긴(lockedAt) 설문은 고칠 수 없다(잠금은 서버).
    match /surveys/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() && request.resource.data.get('lockedAt', null) == null;
      allow update: if isAdmin() && resource.data.get('lockedAt', null) == null && request.resource.data.get('lockedAt', null) == null;
      allow delete: if isAdmin() && resource.data.get('lockedAt', null) == null;
    }
    // 교사마다 채점·분석 보기 설정(4-3)
    match /teacherPrefs/{uid} {
      allow read, write: if isSelf(uid) && isTeacher();
    }
    match /audit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /requests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // ── 학급·세션 (4-2) ──
    match /classes/{cid} {
      allow read: if teaches(resource.data.teacherUids);
      allow write: if false;
    }
    match /sessions/{sid} {
      allow read: if teaches(resource.data.teacherUids) || memberOf(sid);
      // 담당 교사는 진행 설정만 바꾼다(구조·코드·담당 교사는 서버)
      allow update: if teaches(resource.data.teacherUids)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['open', 'propositionIds', 'stagesOpen', 'consentRequired', 'surveyId', 'surveyPreOpen', 'surveyPostOpen', 'principleOpen', 'codeOpen', 'updatedAt', 'pacing']);
      allow create, delete: if false;

      match /members/{uid} {
        allow read: if isSelf(uid) || teachesSession(sid);
        allow write: if false;
      }
      // 채점·대화 태그·AI가 읽은 글 고치기, 면담(4-3): 학생마다 한 문서, 담당 교사만. 학생은 볼 수 없다.
      match /grading/{uid} {
        allow read, write: if teachesSession(sid);
      }
      match /interviews/{uid} {
        allow read, write: if teachesSession(sid);
      }
      // 면담 녹음 정보(4-4, 파일은 Storage recordings/{회차}/{uid}/…): 담당 교사·관리자만
      match /recordings/{recId} {
        allow read, write: if teachesSession(sid);
      }
      // 연구 모드 AI 대화 기록(5-1): 서버만 쓰고 담당 교사·관리자가 읽는다(위·변조 방지)
      match /aiLogs/{logId} {
        allow read: if teachesSession(sid);
        allow write: if false;
      }

      match /records/{uid} {
        function before() { return resource == null ? {} : resource.data.get('stages', {}); }
        function after() { return request.resource.data.get('stages', {}); }
        // 제출한 단계는 그대로
        function kept(n) { return before().get(n, null) == null || before()[n].get('submittedAt', null) == null || after().get(n, null) == before()[n]; }
        // 바뀐 단계는 교사가 연 단계여야 한다
        function openOrSame(n, num) { return after().get(n, null) == before().get(n, null) || num in sessionData(sid).stagesOpen; }
        function stagesOk() {
          return kept('1') && kept('2') && kept('3') && kept('4')
            && openOrSame('1', 1) && openOrSame('2', 2) && openOrSame('3', 3) && openOrSame('4', 4);
        }
        // 학생(세션 코드로 들어온 사람) 또는 미리보기하는 담당 교사 본인
        function writer() { return isSelf(uid) && (memberOf(sid) || teachesSession(sid)); }

        allow read: if isSelf(uid) || teachesSession(sid);
        allow create, update: if writer() && stagesOk();
        allow delete: if false;

        // 펜 필기(단계~명제~칸마다 한 문서). 그 단계를 제출한 뒤에는 바꿀 수 없다.
        match /ink/{key} {
          function recordPath() { return /databases/$(database)/documents/sessions/$(sid)/records/$(uid); }
          function stageOpenForInk() {
            let stage = string(request.resource.data.stage);
            return !exists(recordPath())
              || get(recordPath()).data.get('stages', {}).get(stage, {}).get('submittedAt', null) == null;
          }
          allow read: if isSelf(uid) || teachesSession(sid);
          allow write: if writer() && stageOpenForInk();
        }
      }
    }

    // ── AI 사용량(5-1): 서버만 쓴다. 본인은 오늘 쓴 횟수를 읽는다 ──
    match /aiUsage/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // ── 증명 연습 기록 (4-2): 본인만 읽고 쓴다. 통과·인증의 서버 확인은 5단계 ──
    // 교사는 업무판의 증명 연습 현황에서 담당 학급 학생의 요약만 서버 함수(api/session.js classPractice)로 받는다(2026-11-28)
    match /practice/{uid}/attempts/{id} {
      allow read: if isSelf(uid);
      allow write: if isSelf(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
