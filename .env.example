# 변수 이름만 적는다. 실제 값은 .env.local(로컬, 저장소에 올리지 않음)과 Vercel 환경 변수에 넣는다.

# Firebase 웹 설정값 (공개되어도 되는 식별자, 브라우저 번들에 들어감)
# 하나라도 비어 있으면 앱은 브라우저 저장만 쓰는 프로토타입 모드로 동작한다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 서버 함수(api/) 전용 비밀 값. VITE_ 접두사를 절대 붙이지 않는다.
# 배포: 서비스 계정 JSON 파일 내용 전체를 FIREBASE_SERVICE_ACCOUNT에 넣는다(Vercel, 민감 값).
# 로컬: 키 파일을 프로젝트 폴더 밖에 두고 그 경로를 GOOGLE_APPLICATION_CREDENTIALS에 넣는다.
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=
# 처음 관리자가 될 구글 이메일(쉼표로 여럿). 이 이메일로 로그인하면 관리자 역할이 붙는다.
ADMIN_EMAILS=
